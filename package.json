{
  "name": "dsh-go-exam-helper",
  "version": "1.7.1",
  "description": "DSH Go 答题助手：盯住考试页面，把答案弹在顶部通知里。题库可选，图形题走视觉。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-go",
    "exam",
    "ocr",
    "notification"
  ],
  "license": "MIT",
  "author": "aishenkiki",
  "homepage": "https://github.com/aishenkiki/dsh-go-exam-helper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aishenkiki/dsh-go-exam-helper.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "payload",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "client.js",
    "locale",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "答题助手",
      "en": "Exam helper"
    },
    "icon": "book",
    "contributes": {
      "panels": [
        {
          "id": "exam",
          "title": {
            "zh": "答题助手",
            "en": "Exam helper"
          },
          "icon": "chart",
          "placement": [
            "session.tab",
            "features"
          ]
        },
        {
          "id": "cost",
          "title": {
            "zh": "费用",
            "en": "Cost"
          },
          "icon": "chart",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ],
      "composer.tools": [
        {
          "id": "exam-tool",
          "label": {
            "zh": "答题助手",
            "en": "Exam"
          },
          "icon": "book",
          "panel": "exam"
        }
      ],
      "composer.actions": [
        {
          "id": "exam-open",
          "label": {
            "zh": "答题助手",
            "en": "Exam"
          },
          "icon": "book"
        },
        {
          "id": "cost-open",
          "label": {
            "zh": "费用",
            "en": "Cost"
          },
          "icon": "chart"
        }
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  }
}